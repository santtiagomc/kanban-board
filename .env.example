# Environment variables template. This file IS committed to git.
# Copy it to `.env` and fill in the real values:
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL=

# Random key used to sign session cookies. Generate your own:
#   Windows (PowerShell):
#     $b = New-Object byte[] 32
#     [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#     [Convert]::ToBase64String($b)
#   macOS / Linux:
#     openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# "Suggest subtasks" feature. BOTH OF THESE ARE OPTIONAL.
#
# With no key the app still works: it falls back to a local mock that builds
# suggestions from templates, with no network call and no cost. Set a key
# only if you want real AI suggestions.
# ---------------------------------------------------------------------------

# Google Gemini. Free key, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model. Leave empty to use the default (gemini-3.8-flash).
# If it stops working, the 404 message names the model to use instead - the
# server output is more reliable than the /models listing, which includes
# models that are closed to new API keys.
GEMINI_MODEL=
