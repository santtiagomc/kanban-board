# Environment variables template. This file IS committed to git.
# Copy it to `.env` and fill in the real values:
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL=

# Random key used to sign session cookies. Generate your own:
#   Windows (PowerShell):
#     $b = New-Object byte[] 32
#     [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#     [Convert]::ToBase64String($b)
#   macOS / Linux:
#     openssl rand -base64 32
AUTH_SECRET=
