// Prisma schema: describes the shape of the data.
// From this file Prisma generates two things:
//   1. The SQL that creates the tables in PostgreSQL (the "migrations")
//   2. The TypeScript types used throughout the app
// Docs: https://pris.ly/d/prisma-schema

// Where to write the generated client. In Prisma 7 the client is TypeScript code
// that lives inside the project (not hidden in node_modules), so the path is required.
// That folder is in .gitignore: it's generated code and must never be edited by hand.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Only declares the database engine.
// The connection URL lives in prisma7.config.ts, which reads it from .env
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// USER
// ---------------------------------------------------------------------------
model User {
  id String @id @default(cuid())

  email String @unique // @unique => two users can't share the same email

  // The password is never stored in plain text, only its bcrypt hash.
  // A hash is one-way: it can verify a password, but not recover it.
  passwordHash String

  name String? // "?" makes the field optional (NULL allowed in SQL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Prisma refreshes this timestamp on every update

  // "Many" side of the relation: a user has many boards.
  // This field does NOT create a database column; it only enables queries like:
  // prisma.user.findUnique({ include: { boards: true } })
  boards Board[]
}

// ---------------------------------------------------------------------------
// BOARD
// ---------------------------------------------------------------------------
model Board {
  id    String @id @default(cuid())
  title String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign key to User. This pair of lines is the pattern repeated in every relation:
  //   - ownerId: the actual column stored in the table
  //   - owner:   a shortcut to reach the full User object from code
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  columns Column[]

  // An index speeds up filtering by this column. The most common query will be
  // "get all boards for user X", so it's worth having.
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// COLUMN (a list: "To do", "In progress", "Done")
// ---------------------------------------------------------------------------
model Column {
  id    String @id @default(cuid())
  title String

  // Left-to-right order: 0, 1, 2...
  // Required because a database does NOT guarantee row order,
  // so the order has to be stored explicitly.
  //
  // Note: we intentionally do NOT add @@unique([boardId, position]). It's tempting
  // ("two columns can't share a position"), but while reordering there's a moment
  // with duplicate positions and the database would reject the update.
  position Int

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards Card[]

  @@index([boardId])
}

// ---------------------------------------------------------------------------
// CARD (a task)
// ---------------------------------------------------------------------------
model Card {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime? // Optional deadline
  position    Int // Top-to-bottom order within its column

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  subtasks Subtask[]

  @@index([columnId])
}

// ---------------------------------------------------------------------------
// SUBTASK (where accepted AI suggestions are stored)
// ---------------------------------------------------------------------------
model Subtask {
  id       String  @id @default(cuid())
  title    String
  done     Boolean @default(false)
  position Int

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}
